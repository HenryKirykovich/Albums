<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlbumsGrpc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generates the C# classes (Album, AlbumService.AlbumServiceBase, ...) from the .proto file -->
    <Protobuf Include="Protos\album_service.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.62.0" />
  </ItemGroup>

</Project>
